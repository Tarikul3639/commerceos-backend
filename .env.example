# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=5000

API_PREFIX=api
API_VERSION=1

APP_VERSION=1.0.0
APP_NAME=CommerceOS

FRONTEND_URL=http://localhost:3001


# ==========================================
# SECURITY
# ==========================================

BCRYPT_SALT_ROUNDS=10


# ==========================================
# PASSWORD RESET
# ==========================================

JWT_USER_PASSWORD_RESET_EXPIRES_IN=15m
JWT_CUSTOMER_PASSWORD_RESET_EXPIRES_IN=15m


# ==========================================
# USER JWT
# ==========================================

JWT_USER_ACCESS_SECRET=your_user_access_secret
JWT_USER_ACCESS_EXPIRES_IN=15m

JWT_USER_REFRESH_SECRET=your_user_refresh_secret
JWT_USER_REFRESH_EXPIRES_IN=7d

JWT_USER_REMEMBER_REFRESH_EXPIRES_IN=30d


# ==========================================
# CUSTOMER JWT
# ==========================================

JWT_CUSTOMER_ACCESS_SECRET=your_customer_access_secret
JWT_CUSTOMER_ACCESS_EXPIRES_IN=15m

JWT_CUSTOMER_REFRESH_SECRET=your_customer_refresh_secret
JWT_CUSTOMER_REFRESH_EXPIRES_IN=7d


# ==========================================
# EMAIL VERIFICATION
# ==========================================

JWT_USER_EMAIL_VERIFICATION_EXPIRES_IN=15m
JWT_CUSTOMER_EMAIL_VERIFICATION_EXPIRES_IN=15m


# ==========================================
# DATABASE
# ==========================================

DATABASE_URL="postgresql://postgres:password@localhost:5432/commerceos?schema=public"


# ==========================================
# CORS
# ==========================================

CORS_ORIGIN=http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_CREDENTIALS=true
CORS_ALLOWED_HEADERS=Content-Type,Authorization


# ==========================================
# CLOUDINARY
# ==========================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_ROOT_FOLDER=commerceos


# ==========================================
# SWAGGER
# ==========================================

SWAGGER_ENABLED=true


# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=debug


# ==========================================
# SMTP / EMAIL
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com