generator client {
  provider     = "prisma-client"
  output       = "../src/lib/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/**
 * ============================================================
 * ENUMS
 * ============================================================
 */

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum PaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ActivityType {
  CREATE
  UPDATE
  DELETE

  LOGIN
  LOGOUT
  PASSWORD_CHANGE

  STATUS_CHANGE

  APPROVE
  REJECT
  COMPLETE
  CANCEL

  OTHER
}

enum ActivityModule {
  AUTH
  USER
  ROLE
  PERMISSION

  PRODUCT
  CATEGORY
  BRAND
  SUPPLIER
  WAREHOUSE
  INVENTORY
  PURCHASE
  STOCK_TRANSFER
  STOCK_MOVEMENT
  DISCOUNT

  CUSTOMER
  CART
  ORDER
  PAYMENT
  ORDER_RETURN
  PURCHASE_RETURN

  EMPLOYEE
  SETTINGS
  NOTIFICATION

  OTHER
}

enum StockMovementType {
  PURCHASE
  SALE
  ORDER_RETURN
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum OrderReturnStatus {
  PENDING
  APPROVED
  PARTIALLY_PAID
  REJECTED
  COMPLETED
}

enum PurchaseReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum PermissionName {
  // USER
  USER_CREATE
  USER_READ
  USER_UPDATE
  USER_DELETE

  // ROLE
  ROLE_CREATE
  ROLE_READ
  ROLE_UPDATE
  ROLE_DELETE

  // PRODUCT
  PRODUCT_CREATE
  PRODUCT_READ
  PRODUCT_UPDATE
  PRODUCT_DELETE

  // ORDER
  ORDER_CREATE
  ORDER_READ
  ORDER_UPDATE
  ORDER_DELETE

  // PURCHASE
  PURCHASE_CREATE
  PURCHASE_READ
  PURCHASE_UPDATE
  PURCHASE_DELETE

  // STOCK
  STOCK_CREATE
  STOCK_READ
  STOCK_UPDATE
  STOCK_DELETE
}

enum BannerType {
  HERO
  PROMOTION
  OFFER
  PRODUCT
  CATEGORY
  CUSTOM
}

enum BannerPosition {
  HOME_TOP
  HOME_MIDDLE
  HOME_BOTTOM
}

/**
 * ============================================================
 * AUTH & ACCESS CONTROL
 * ============================================================
 */

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  phone    String? @unique
  password String

  avatar   String?
  // Cloudinary public ID used to delete the image
  publicId String? @unique

  // User status and verification
  status UserStatus @default(ACTIVE)

  // Stores the timestamp when the user was soft deleted
  deletedAt DateTime?

  isVerified  Boolean   @default(false)
  lastLoginAt DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Stores refresh token records for this user
  refreshTokens           UserRefreshToken[]
  // Stores password reset token records for this user
  passwordResetTokens     UserPasswordResetToken[]
  // Stores email verification token records for this user
  emailVerificationTokens UserEmailVerificationToken[]

  orders   Order[]
  employee Employee?

  discounts      Discount[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]

  purchases Purchase[]
  payments  Payment[]

  createdOrderReturns  OrderReturn[] @relation("OrderReturnCreatedBy")
  approvedOrderReturns OrderReturn[] @relation("OrderReturnApprovedBy")

  createdPurchaseReturns  PurchaseReturn[] @relation("PurchaseReturnCreatedBy")
  approvedPurchaseReturns PurchaseReturn[] @relation("PurchaseReturnApprovedBy")

  // Activity Logs
  activityLogs    ActivityLog[]
  // Notifications
  notifications   Notification[]
  // Email Logs
  triggeredEmails EmailLog[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model RolePermission {
  // The role to which this permission is assigned
  roleId     String
  role       Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  // Fixed permission enum
  permission PermissionName

  createdAt DateTime @default(now())

  // A role cannot have the same permission twice
  @@id([roleId, permission])
  @@index([permission])
  @@map("role_permissions")
}

model UserRefreshToken {
  id String @id @default(cuid())

  // Hashed Refresh Token
  tokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userAgent String?
  ipAddress String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_refresh_tokens")
}

model UserPasswordResetToken {
  id String @id @default(cuid())

  // Hashed Reset Token
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("user_password_reset_tokens")
}

model UserEmailVerificationToken {
  id        String @id @default(cuid())
  // Hashed Verification Token
  tokenHash String @unique

  expiresAt  DateTime
  verifiedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("user_email_verification_tokens")
}

model Employee {
  id String @id @default(cuid())

  designation String
  salary      Decimal?
  joiningDate DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

/**
 * ============================================================
 * PRODUCT CATALOG
 * ============================================================
 */

model Category {
  id String @id @default(cuid())

  name        String  @unique
  slug        String  @unique
  description String?

  image    String?
  // Cloudinary public ID used to delete the image
  publicId String? @unique

  // Controls whether the category can currently be used
  isActive Boolean @default(true)

  // Stores the timestamp when the category was soft deleted
  deletedAt DateTime?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("categories")
}

model Brand {
  id String @id @default(cuid())

  name        String  @unique
  slug        String  @unique
  description String?

  image    String?
  // Cloudinary public ID used to delete the image
  publicId String? @unique

  // Controls whether the brand can currently be used
  isActive Boolean @default(true)

  // Stores the timestamp when the brand was soft deleted
  deletedAt DateTime?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("brands")
}

model Product {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  description String?

  // Optional thumbnail image for the product
  thumbnail String?
  // Cloudinary public ID used to delete the image
  publicId  String? @unique

  // Controls whether the product can currently be sold or used
  isActive Boolean @default(true)

  // Stores the timestamp when the product was soft deleted
  deletedAt DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Optional brand associated with the product
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  images ProductImage[]

  // Discounts associated with this product
  discounts ProductDiscount[]

  // Variants associated with this product
  productVariants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([deletedAt])
  @@map("products")
}

model Attribute {
  id String @id @default(cuid())

  // The name of the product attribute
  name String @unique

  values AttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attributes")
}

model AttributeValue {
  id String @id @default(cuid())

  // The value of the product attribute
  value String

  // Minimum quantity before this variant is considered low in stock
  minimumStock Int @default(0)

  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  variantValues VariantAttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents duplicate values for the same attribute
  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_values")
}

model ProductVariant {
  id String @id @default(cuid())

  // Unique stock keeping unit for this variant
  sku String @unique

  // Optional image specific to this product variant
  image    String?
  // Cloudinary public ID used to delete the image
  publicId String? @unique

  // Optional barcode used for product scanning
  barcode String? @unique

  // The cost price paid to purchase this variant
  purchasePrice Decimal

  // The price charged to customers for this variant
  sellingPrice Decimal

  // Controls whether this variant can currently be sold
  isActive Boolean @default(true)

  // Stores the timestamp when the variant was soft deleted
  deletedAt DateTime?

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributeValues VariantAttributeValue[]
  inventories     Inventory[]
  purchaseItems   PurchaseItem[]

  stockMovements     StockMovement[]
  stockTransferItems StockTransferItem[]

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([deletedAt])
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeValueId String

  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])
  createdAt      DateTime       @default(now())

  // Prevents duplicate attribute values in the same variant
  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

model ProductImage {
  id String @id @default(cuid())

  imageUrl String

  // Cloudinary public ID used to delete the image
  publicId String @unique

  // Defines the display order of the product image
  sortOrder Int @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_images")
}

/**
 * ============================================================
 * INVENTORY & WAREHOUSE
 * ============================================================
 */

model Warehouse {
  id      String  @id @default(cuid())
  name    String  @unique
  address String?

  // Controls whether the warehouse can currently be used
  isActive Boolean @default(true)

  // Stores the timestamp when the warehouse was soft deleted
  deletedAt DateTime?

  inventories        Inventory[]
  purchases          Purchase[]
  stockMovements     StockMovement[]
  fromStockTransfers StockTransfer[] @relation("FromWarehouse")
  toStockTransfers   StockTransfer[] @relation("ToWarehouse")
  orders             Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("warehouses")
}

model StockMovement {
  id String @id @default(cuid())

  type StockMovementType

  // Positive value increases stock, negative value decreases stock
  quantity Int

  // Stock quantity before the movement
  previousQuantity Int

  // Stock quantity after the movement
  currentQuantity Int

  // Optional explanation for the stock change
  reason String?

  variantId String
  // Product variant affected by this stock movement
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  // User who performed this stock movement
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([warehouseId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockTransfer {
  id String @id @default(cuid())

  transferNo String @unique

  status StockTransferStatus @default(PENDING)

  // Optional note about this stock transfer
  notes String?

  fromWarehouseId String
  fromWarehouse   Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouseId String
  toWarehouse   Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  items StockTransferItem[]

  // User who created this stock transfer
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([userId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id String @id @default(cuid())

  quantity Int

  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  variantId String

  // Product variant being transferred
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transferId, variantId])
  @@index([transferId])
  @@index([variantId])
  @@map("stock_transfer_items")
}

model Inventory {
  id String @id @default(cuid())

  // Current available quantity of the variant in this warehouse
  quantity Int @default(0)

  // Quantity reserved for pending orders
  reservedQuantity Int @default(0)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One product variant can have only one inventory record per warehouse
  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("inventories")
}

/**
 * ============================================================
 * PURCHASE & SUPPLIER
 * ============================================================
 */

model Supplier {
  id String @id @default(cuid())

  name String

  email String? @unique
  phone String? @unique

  address String?

  // The primary person to contact at the supplier
  contactPerson String?

  // Controls whether the supplier can currently be used
  isActive Boolean @default(true)

  // Stores the timestamp when the supplier was soft deleted
  deletedAt DateTime?

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("suppliers")
}

model Purchase {
  id String @id @default(cuid())

  invoiceNo String @unique
  subtotal Decimal
  discount Decimal @default(0)
  tax Decimal @default(0)
  total Decimal

  status PurchaseStatus @default(PENDING)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Warehouse where the purchased products will be added
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  purchaseItems PurchaseItem[]
  returns       PurchaseReturn[]

  // The user who created this purchase
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([userId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id String @id @default(cuid())

  quantity Int

  // Purchase price per unit
  unitPrice Decimal

  subtotal Decimal

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  variantId String

  // Product variant included in this purchase
  variant ProductVariant @relation(fields: [variantId], references: [id])

  returnItems PurchaseReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_items")
}

model ProductDiscount {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  // Indicates whether this discount assignment is currently active
  isActive  Boolean   @default(true)
  // Stores the timestamp when this discount assignment was soft deleted
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents the same discount from being assigned to the same product multiple times
  @@unique([productId, discountId])
  // Useful for finding active discounts for a product
  @@index([productId, isActive])
  @@index([productId])
  @@index([discountId])
  @@index([deletedAt])
  @@map("product_discounts")
}

model Discount {
  id String @id @default(cuid())

  name String

  description String?

  // Defines whether the discount is a percentage or fixed amount
  type DiscountType

  // The discount amount or percentage value
  value Decimal

  // The date and time when the discount becomes active
  startDate DateTime?

  // The date and time when the discount expires
  endDate DateTime?

  // Controls whether the discount can currently be applied
  isActive Boolean @default(true)

  // Stores the timestamp when the discount was soft deleted
  deletedAt DateTime?

  createdById String
  // The user who created this discount
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  products ProductDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([deletedAt])
  @@map("discounts")
}

/**
 * ============================================================
 * SALES
 * ============================================================
 */

model Customer {
  id String @id @default(cuid())

  name     String
  email    String  @unique
  phone    String? @unique
  password String
  address  String?

  // Controls the current status of the customer account
  status CustomerStatus @default(ACTIVE)

  // Indicates whether the customer's email has been verified
  isVerified Boolean @default(false)

  // Stores the timestamp of the customer's last successful login
  lastLoginAt DateTime?

  // Stores the timestamp when the customer was soft deleted
  deletedAt DateTime?

  refreshTokens           CustomerRefreshToken[]
  passwordResetTokens     CustomerPasswordResetToken[]
  emailVerificationTokens CustomerEmailVerificationToken[]

  orders Order[]
  cart   Cart?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@map("customers")
}

model CustomerRefreshToken {
  id String @id @default(cuid())

  tokenHash String

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userAgent String?
  ipAddress String?

  customerId String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_refresh_tokens")
}

model CustomerEmailVerificationToken {
  id String @id @default(cuid())

  tokenHash String @unique

  expiresAt  DateTime
  verifiedAt DateTime?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_email_verification_tokens")
}

model CustomerPasswordResetToken {
  id String @id @default(cuid())

  // Stores the hashed password reset token
  tokenHash String @unique

  // Defines when the password reset token expires
  expiresAt DateTime
  // Stores when the token was successfully used
  usedAt    DateTime?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_password_reset_tokens")
}

model Cart {
  id String @id @default(cuid())

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id String @id @default(cuid())

  quantity Int

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  // Product variant added to this cart
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents the same product variant from being added multiple times to the same cart
  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id String @id @default(cuid())

  invoiceNo String @unique

  // The subtotal amount of the order before any discounts or taxes
  subtotal Decimal
  // The discount amount applied to the order
  discount Decimal @default(0)
  // The tax amount applied to the order
  tax      Decimal @default(0)
  // The total amount to be paid for the order
  total    Decimal

  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  warehouseId String
  // The warehouse from which the order items will be fulfilled
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  orderItems OrderItem[]
  payments   Payment[]

  returns OrderReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([warehouseId])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  quantity Int

  // The price of the variant at the time the order was placed
  unitPrice Decimal
  // The total price for this order item (unitPrice * quantity)
  subtotal Decimal

  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  // Product variant included in this order
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  returnItems OrderReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id String @id @default(cuid())

  amount Decimal

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  // Defines whether this record is a payment or a refund
  type PaymentType @default(PAYMENT)

  // Transaction reference from the payment provider
  transactionId String?

  // Additional information about the payment
  notes String?

  // The order this payment is associated with
  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // User who recorded or processed the payment
  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([method])
  @@map("payments")
}

model OrderReturn {
  id String @id @default(cuid())

  returnNo String @unique

  status OrderReturnStatus @default(PENDING)

  // Reason provided for returning the order
  reason String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  items OrderReturnItem[]

  // User who processed the return
  createdById String
  createdBy   User   @relation("OrderReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // User who approved or rejected the return
  approvedById String?
  approvedBy   User?   @relation("OrderReturnApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([createdById])
  @@index([approvedById])
  @@index([status])
  @@map("order_returns")
}

model OrderReturnItem {
  id String @id @default(cuid())

  quantity Int

  // Reason for returning this specific item
  reason String?

  returnId    String
  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  // The original order item being returned
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([returnId, orderItemId])
  @@index([returnId])
  @@index([orderItemId])
  @@map("order_return_items")
}

model PurchaseReturn {
  id String @id @default(cuid())

  returnNo String               @unique
  status   PurchaseReturnStatus @default(PENDING)

  // Reason for returning products to the supplier
  reason String?

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  items PurchaseReturnItem[]

  // User who processed the purchase return
  createdById String
  createdBy   User   @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // User who approved or rejected the purchase return
  approvedById String?
  approvedBy   User?   @relation("PurchaseReturnApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([createdById])
  @@index([approvedById])
  @@index([status])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id String @id @default(cuid())

  quantity Int

  // Reason for returning this specific item
  reason String?

  returnId       String
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  // The original purchase item being returned
  purchaseItemId String
  purchaseItem   PurchaseItem @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([returnId, purchaseItemId])
  @@index([returnId])
  @@index([purchaseItemId])
  @@map("purchase_return_items")
}

/**
 * ============================================================
 * SYSTEM & AUDIT
 * ============================================================
 */

model Settings {
  id String @id @default(cuid())

  companyName    String
  companyEmail   String
  companyPhone   String
  companyAddress String

  logo    String?
  favicon String?

  currency String @default("BDT")
  timezone String @default("Asia/Dhaka")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model ActivityLog {
  id String @id @default(cuid())

  type   ActivityType
  module ActivityModule

  action String

  description String?

  // Which entity the activity has occurred on, its type and id
  entityType String?
  entityId   String?
  // Old value before the change
  oldValue   Json?

  // New value after the change
  newValue Json?

  // Metadata about the activity
  ipAddress String?
  userAgent String?
  userId    String?
  // The user who performed the activity
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id String @id @default(cuid())

  title String

  message String

  type NotificationType @default(INFO)

  // Indicates whether the notification has been read
  isRead Boolean @default(false)

  // Optional URL or frontend path related to this notification
  link String?

  // The related entity type
  entityType String?

  // The related entity ID
  entityId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("notifications")
}

model EmailLog {
  id String @id @default(cuid())

  // Email address of the recipient
  to String

  // Subject of the email
  subject String

  // Email content
  body String

  status EmailStatus @default(PENDING)

  // Error message if sending the email fails
  errorMessage String?

  // The timestamp when the email was successfully sent
  sentAt DateTime?

  // The related entity type
  entityType String?

  // The related entity ID
  entityId String?

  // Number of times the email sending was attempted
  attemptCount Int @default(0)

  // The user who triggered this email
  triggeredById String?
  triggeredBy   User?   @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([to])
  @@index([status])
  @@index([triggeredById])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("email_logs")
}

model Banner {
  id    String  @id @default(cuid())
  title String?

  // Banner image URL
  imageUrl       String
  // Optional image for mobile devices
  mobileImageUrl String?

  type     BannerType
  position BannerPosition

  // Redirect URL when banner is clicked
  link       String?
  buttonText String?

  // Controls display order
  sortOrder Int @default(0)

  isActive Boolean @default(true)

  // Banner visibility period
  startAt DateTime?
  endAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([position])
  @@index([isActive])
  @@map("banners")
}
