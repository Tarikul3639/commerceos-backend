/**
 * ============================================================
 * ORDER MODELS
 * ============================================================
 */

enum PaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum OrderReturnStatus {
  PENDING
  APPROVED
  PARTIALLY_PAID
  REJECTED
  COMPLETED
}

model Cart {
  id String @id @default(cuid())

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id String @id @default(cuid())

  quantity Int

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id String @id @default(cuid())

  invoiceNo String @unique

  subtotal Decimal
  discount Decimal @default(0)
  tax      Decimal @default(0)
  total    Decimal

  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]
  payments   Payment[]
  returns    OrderReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  quantity  Int
  unitPrice Decimal
  subtotal  Decimal

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  returnItems OrderReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id String @id @default(cuid())

  amount Decimal

  method PaymentMethod
  status PaymentStatus @default(PENDING)
  type   PaymentType   @default(PAYMENT)

  transactionId String?
  notes         String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([method])
  @@map("payments")
}

model OrderReturn {
  id String @id @default(cuid())

  returnNo String            @unique
  status   OrderReturnStatus @default(PENDING)

  reason String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  items OrderReturnItem[]

  createdById String
  createdBy   User   @relation("OrderReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  approvedById String?
  approvedBy   User?   @relation("OrderReturnApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([createdById])
  @@index([approvedById])
  @@index([status])
  @@map("order_returns")
}

model OrderReturnItem {
  id String @id @default(cuid())

  quantity Int
  reason   String?

  returnId    String
  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([returnId, orderItemId])
  @@index([returnId])
  @@index([orderItemId])
  @@map("order_return_items")
}
