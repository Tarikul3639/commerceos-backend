/**
 * ============================================================
 * INVENTORY & WAREHOUSE
 * ============================================================
 */

enum StockMovementType {
  PURCHASE
  SALE
  ORDER_RETURN
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Warehouse {
  id String @id @default(cuid())

  name String @unique
  address String?

  // Controls whether the warehouse can currently be used
  isActive Boolean @default(true)

  // Stores the timestamp when the warehouse was soft deleted
  deletedAt DateTime?

  inventories Inventory[]
  purchases Purchase[]
  stockMovements StockMovement[]

  fromStockTransfers StockTransfer[] @relation("FromWarehouse")
  toStockTransfers StockTransfer[] @relation("ToWarehouse")

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("warehouses")
}

model StockMovement {
  id String @id @default(cuid())

  type StockMovementType

  // Positive value increases stock, negative value decreases stock
  quantity Int

  // Stock quantity before the movement
  previousQuantity Int

  // Stock quantity after the movement
  currentQuantity Int

  // Optional explanation for the stock change
  reason String?

  variantId String

  // Product variant affected by this stock movement
  variant ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  // User who performed this stock movement
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([variantId])
  @@index([warehouseId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockTransfer {
  id String @id @default(cuid())

  transferNo String @unique

  status StockTransferStatus @default(PENDING)

  // Optional note about this stock transfer
  notes String?

  fromWarehouseId String
  fromWarehouse Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouseId String
  toWarehouse Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  items StockTransferItem[]

  // User who created this stock transfer
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([userId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id String @id @default(cuid())

  quantity Int

  transferId String
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  variantId String

  // Product variant being transferred
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transferId, variantId])
  @@index([transferId])
  @@index([variantId])
  @@map("stock_transfer_items")
}

model Inventory {
  id String @id @default(cuid())

  // Current available quantity of the variant in this warehouse
  quantity Int @default(0)

  // Quantity reserved for pending orders
  reservedQuantity Int @default(0)

  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One product variant can have only one inventory record per warehouse
  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("inventories")
}