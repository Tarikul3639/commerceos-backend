/**
 * ============================================================
 * AUTH & ACCESS CONTROL
 * ============================================================
 */

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Permission {
  USER_CREATE
  USER_READ
  USER_UPDATE
  USER_DELETE

  PERMISSION_READ
  PERMISSION_UPDATE

  PRODUCT_CREATE
  PRODUCT_READ
  PRODUCT_UPDATE
  PRODUCT_DELETE

  ORDER_CREATE
  ORDER_READ
  ORDER_UPDATE
  ORDER_DELETE

  PURCHASE_CREATE
  PURCHASE_READ
  PURCHASE_UPDATE
  PURCHASE_DELETE

  STOCK_CREATE
  STOCK_READ
  STOCK_UPDATE
  STOCK_DELETE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  phone    String? @unique
  password String

  avatar   String?
  // Cloudinary public ID used to delete the image
  publicId String? @unique

  // User status and verification
  status UserStatus @default(ACTIVE)

  // Stores the timestamp when the user was soft deleted
  deletedAt DateTime?

  isVerified  Boolean   @default(false)
  lastLoginAt DateTime?

  role Role @default(EMPLOYEE)

  // Stores refresh token records for this user
  refreshTokens UserRefreshToken[]

  // Stores password reset token records for this user
  passwordResetTokens UserPasswordResetToken[]

  // Stores email verification token records for this user
  emailVerificationTokens UserEmailVerificationToken[]

  orders    Order[]
  discounts Discount[]

  purchases Purchase[]
  payments  Payment[]

  createdOrderReturns  OrderReturn[] @relation("OrderReturnCreatedBy")
  approvedOrderReturns OrderReturn[] @relation("OrderReturnApprovedBy")

  createdPurchaseReturns  PurchaseReturn[] @relation("PurchaseReturnCreatedBy")
  approvedPurchaseReturns PurchaseReturn[] @relation("PurchaseReturnApprovedBy")

  // Activity Logs
  activityLogs ActivityLog[]

  // Notifications
  notifications Notification[]

  // Email Logs
  triggeredEmails EmailLog[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model RolePermission {
  id         String     @id @default(cuid())
  role       Role
  permission Permission

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, permission])
  @@index([role])
  @@index([permission])
  @@map("role_permissions")
}

model UserRefreshToken {
  id String @id @default(cuid())

  // Hashed Refresh Token
  tokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userAgent String?
  ipAddress String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_refresh_tokens")
}

model UserPasswordResetToken {
  id String @id @default(cuid())

  // Hashed Reset Token
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("user_password_reset_tokens")
}

model UserEmailVerificationToken {
  id String @id @default(cuid())

  // Hashed Verification Token
  tokenHash String @unique

  expiresAt  DateTime
  verifiedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("user_email_verification_tokens")
}
