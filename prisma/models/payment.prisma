
enum PaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  ROCKET
}

enum PaymentProvider {
  MANUAL
  STRIPE
  SSL_COMMERZ
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum PaymentGatewayMode {
  TEST
  LIVE
}

model Payment {
  id       String          @id @default(uuid())
  amount   Decimal         @db.Decimal(12, 2)
  currency String          @default("BDT")
  method   PaymentMethod
  provider PaymentProvider @default(MANUAL)
  status   PaymentStatus   @default(PENDING)
  type     PaymentType     @default(PAYMENT)

  // External gateway references and duplicate-request protection.
  transactionId  String?
  sessionId      String?
  idempotencyKey String? @unique
  notes          String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Links refund transactions to their original payment.
  originalPaymentId String?
  originalPayment   Payment?  @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  refunds           Payment[] @relation("PaymentRefunds")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([provider])
  @@index([transactionId])
  @@index([sessionId])
  @@index([originalPaymentId])
  @@map("payments")
}

model PaymentGatewayConfig {
  id          String            @id @default(uuid())
  provider    PaymentProvider   @unique
  displayName String
  isEnabled   Boolean           @default(false)
  mode        PaymentGatewayMode @default(TEST)

  // Non-secret settings only; keep credentials in environment variables.
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_gateway_configs")
}
